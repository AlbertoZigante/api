ENV=development
# Comma-separated list of allowed browser origins (modeller + site)
CORS_ORIGINS=http://localhost:5173,http://localhost:4321,https://albertozigante.github.io
# AUTH (docs/SECURITY.md). With ENV=production the app REFUSES to start unless one of these is set.
# Beta gate: comma-separated API keys sent as X-API-Key. NOT a secret in a browser build: a gate, not an identity.
API_KEYS=
# Per-user auth: verify bearer tokens (Supabase / Auth0 / self-issued: scripts/issue_token.py).
# HS256: shared secret, >= 32 chars.   RS256 etc.: the issuer's PEM PUBLIC key in JWT_PUBLIC_KEY.
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_ALGORITHMS=HS256
JWT_AUDIENCE=
JWT_ISSUER=
JWT_LEEWAY_S=10
# RATE LIMITS ("60/minute", "5/second"): per user / API key / IP. Redis once there is more than one instance.
RATE_LIMIT=60/minute
RATE_LIMIT_HEAVY=10/minute
AUTH_FAIL_LIMIT=20/minute
RATE_LIMIT_STORAGE=memory://
# /docs, /redoc, /openapi.json: on in development, off in production unless true.
DOCS_ENABLED=
# Max request body in bytes (413 above). 500 raw panels ~ 340 kB.
MAX_BODY_BYTES=2000000
# Nesting guard rails: CPU budget per call (s) and max simultaneous calls.
NESTING_TIMEOUT_S=10
MAX_CONCURRENT_NESTINGS=4
# process = worker processes (the web process stays responsive); thread = in-process (debugging only)
NESTING_EXECUTOR=process
